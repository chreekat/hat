cabal-version:      3.0
name:               hat
version:            0.1.0
synopsis:           A terminal multiplexer
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Bryan Richter
maintainer:         b@chreekat.net
build-type:         Simple
tested-with:        GHC == 9.10.3

flag profiling
    description: Build for info-table heap profiling: -finfo-table-map and
                 -fdistinct-constructor-tables give samples source provenance.
                 Run with +RTS -hi -l and feed the .eventlog to eventlog2html.
    default:     False
    manual:      True

common defaults
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings

-- Warnings are mandatory: -Weverything -Werror, with a curated set of
-- exemptions. -Wno-* silences noise; -Wno-error=* keeps a warning
-- visible but non-fatal (things we intend to clean up eventually).
common pedantry
    ghc-options:
        -Werror
        -Weverything
        -Wno-all-missed-specialisations
        -Wno-missed-specialisations
        -Wno-missing-exported-signatures
        -Wno-missing-import-lists
        -Wno-missing-local-signatures
        -Wno-missing-safe-haskell-mode
        -Wno-monomorphism-restriction
        -Wno-safe
        -Wno-unsafe
        -Wno-missing-deriving-strategies
        -Wno-missing-kind-signatures
        -Wno-error=unticked-promoted-constructors
        -Wno-error=deprecations
        -Wno-error=identities
        -Wno-error=orphans
        -Wno-error=type-equality-out-of-scope
        -Wno-error=unused-type-patterns
        -- Stylistic and repo-wide; enforcing either is pure churn.
        -Wno-implicit-prelude
        -Wno-prepositive-qualified-module
        -- Needed for ghcid
        -Wno-missing-export-lists

common profiled
    if flag(profiling)
        ghc-options: -finfo-table-map -fdistinct-constructor-tables

library
    import:             defaults, pedantry, profiled
    hs-source-dirs:     src
    exposed-modules:
        Hat.Bench.Residency
        Hat.Client
        Hat.Client.Draw
        Hat.Command.Parser
        Hat.Client.Tty
        Hat.FuzzyMatch
        Hat.Geometry
        Hat.Intern
        Hat.Log
        Hat.Model
        Hat.Model.Ids
        Hat.Model.Options
        Hat.Path
        Hat.Server
        Hat.Server.ClientIO
        Hat.Server.ColorScheme
        Hat.Server.CopyMode
        Hat.Server.Format
        Hat.Server.Keys
        Hat.Server.Layout
        Hat.Server.LayoutString
        Hat.Server.Persist
        Hat.Server.Picker
        Hat.Server.Prompt
        Hat.Server.Reload
        Hat.Server.Render
        Hat.Server.Style
        Hat.Server.Target
        Hat.Server.Title
        Hat.Server.View
        Hat.Term.Cell
        Hat.Term.Emulator
        Hat.Term.HostProtocol
        Hat.Term.Pty
        Hat.Transport.Socket
        Hat.Transport.Wire
    include-dirs:       cbits
    c-sources:          cbits/hat_shim.c
    pkgconfig-depends:  vterm
    build-depends:
        aeson       ^>= 2.2.3.0,
        array       ^>= 0.5.8.0,
        async       ^>= 2.2.6,
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        cborg       ^>= 0.2.10.0,
        containers  ^>= 0.7,
        directory   ^>= 1.3.8.5,
        filepath    ^>= 1.5.4.0,
        megaparsec  ^>= 9.7.0,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        serialise   ^>= 0.2.6.1,
        sqlite-simple ^>= 0.4.19.0,
        stm         ^>= 2.5.3.1,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0,
        vector      ^>= 0.13.2.0

executable hat
    import:             defaults, pedantry, profiled
    hs-source-dirs:     app
    main-is:            Main.hs
    ghc-options:        -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base        ^>= 4.20.2.0,
        directory   ^>= 1.3.8.5,
        hat,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        text        ^>= 2.1.3,
        unix        ^>= 2.8.7.0

executable gen-fixtures
    import:             defaults, pedantry
    hs-source-dirs:     tools
    main-is:            GenFixtures.hs
    ghc-options:        -threaded
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat,
        text        ^>= 2.1.3

-- Replays a preserved reload handover (<socket>.reload.last) through the
-- emulator restore + resize path, to reproduce the libvterm resize abort
-- offline. See tools/ReplayReload.hs.
executable replay-reload
    import:             defaults, pedantry
    hs-source-dirs:     tools
    main-is:            ReplayReload.hs
    ghc-options:        -threaded
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat,
        text        ^>= 2.1.3

-- Memory benches, run on demand (never in the fast unit suite); each Main's
-- header says what it measures. feed-mem: repro of a feed-scaled retention
-- under raw-bytes driving. scrollback-retain: regression guard on the fixed
-- teardown leak. scrollback-live: baseline-judged cost of held scrollback.
benchmark feed-mem
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            FeedMem.hs
    ghc-options:        -rtsopts "-with-rtsopts=-T"
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat

-- -threaded is required: Pty.spawn's reaper does a blocking waitpid.
benchmark scrollback-retain
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            ScrollbackRetain.hs
    other-modules:      PaneSim
    ghc-options:        -threaded -rtsopts "-with-rtsopts=-T"
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat

benchmark scrollback-live
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            ScrollbackLive.hs
    other-modules:      PaneSim
    ghc-options:        -threaded -rtsopts "-with-rtsopts=-T"
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat

test-suite hat-test
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-tool-depends: hat:hat
    other-modules:
        Hat.Bench.ResidencySpec
        Hat.Client.DrawSpec
        Hat.Client.TtySpec
        Hat.Command.ParserSpec
        Hat.FuzzyMatchSpec
        Hat.InternSpec
        Hat.IntegrationSpec
        Hat.LogSpec
        Hat.PathSpec
        Hat.Server.PersistSpec
        Hat.Term.PtySpec
        Hat.Transport.SocketSpec
        Hat.Server.ColorSchemeSpec
        Hat.Server.ConfigSpec
        Hat.Server.CopyModeSpec
        Hat.Server.FlagsSpec
        Hat.Server.FormatSpec
        Hat.Server.KeysSpec
        Hat.Server.LayoutSpec
        Hat.Server.LayoutStringSpec
        Hat.Server.OptionEffectSpec
        Hat.Server.OptionsSpec
        Hat.Server.PickerSpec
        Hat.Server.PromptSpec
        Hat.Server.ReloadSpec
        Hat.Server.SendSpec
        Hat.Server.StyleSpec
        Hat.Server.TargetSpec
        Hat.Server.TitleSpec
        Hat.Server.RenderSpec
        Hat.Server.RestoreSpec
        Hat.Server.SessionSpec
        Hat.Term.EmulatorSpec
        Hat.Term.GoldenSpec
        Hat.Transport.WireSpec
    ghc-options:        -threaded -with-rtsopts=-N
    build-depends:
        async       ^>= 2.2.6,
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        cborg       ^>= 0.2.10.0,
        containers  ^>= 0.7,
        directory   ^>= 1.3.8.5,
        filepath    ^>= 1.5.4.0,
        hspec       ^>= 2.11.17,
        serialise   ^>= 0.2.6.1,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        QuickCheck  ^>= 2.15.0.1,
        stm         ^>= 2.5.3.1,
        hat,
        sqlite-simple ^>= 0.4.19.0,
        vector      ^>= 0.13.2.0,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0

test-suite hat-upstream
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test-upstream
    main-is:            Main.hs
    build-tool-depends: hat:hat
    build-depends:
        base      ^>= 4.20.2.0,
        directory ^>= 1.3.8.5,
        process   ^>= 1.6.26.1

cabal-version:      3.0
name:               hat
version:            0.1.0
synopsis:           A terminal multiplexer
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Bryan Richter
maintainer:         b@chreekat.net
build-type:         Simple
tested-with:        GHC == 9.10.3

flag profiling
    description: Build for info-table heap profiling: -finfo-table-map and
                 -fdistinct-constructor-tables give samples source provenance.
                 Run with +RTS -hi -l and feed the .eventlog to eventlog2html.
    default:     False
    manual:      True

flag ghc-debug
    description: Link ghc-debug-stub and open a debug socket in the server
                 ('GHC.Debug.Stub.withGhcDebug') so ghc-debug-brick can attach
                 to a running server; also turns on info-table maps for named
                 closures. Dev-only; off in production builds.
    default:     False
    manual:      True

common defaults
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings
    if flag(profiling) || flag(ghc-debug)
        ghc-options: -finfo-table-map -fdistinct-constructor-tables

-- Warnings are mandatory: -Weverything -Werror, with a curated set of
-- exemptions. -Wno-* silences noise; -Wno-error=* keeps a warning
-- visible but non-fatal (things we intend to clean up eventually).
common pedantry
    ghc-options:
        -Werror
        -Weverything
        -Wno-all-missed-specialisations
        -Wno-missed-specialisations
        -Wno-missing-exported-signatures
        -Wno-missing-import-lists
        -Wno-missing-local-signatures
        -Wno-missing-safe-haskell-mode
        -Wno-monomorphism-restriction
        -Wno-safe
        -Wno-unsafe
        -Wno-missing-deriving-strategies
        -Wno-missing-kind-signatures
        -Wno-error=unticked-promoted-constructors
        -Wno-error=deprecations
        -Wno-error=identities
        -Wno-error=orphans
        -Wno-error=type-equality-out-of-scope
        -Wno-error=unused-type-patterns
        -- Stylistic and repo-wide; enforcing either is pure churn.
        -Wno-implicit-prelude
        -Wno-prepositive-qualified-module
        -- Needed for ghcid
        -Wno-missing-export-lists

library
    import:             defaults, pedantry
    hs-source-dirs:     src
    exposed-modules:
        Hat.Bench.Residency
        Hat.Client
        Hat.Client.Draw
        Hat.Command.Parser
        Hat.Client.Tty
        Hat.FuzzyMatch
        Hat.Geometry
        Hat.Intern
        Hat.Log
        Hat.Model
        Hat.Model.Ids
        Hat.Model.Options
        Hat.Path
        Hat.Server
        Hat.Server.ClientIO
        Hat.Server.ColorScheme
        Hat.Server.Command.Types
        Hat.Server.CopyMode
        Hat.Server.Environ
        Hat.Server.Format
        Hat.Server.Keys
        Hat.Server.Layout
        Hat.Server.LayoutString
        Hat.Server.Locate
        Hat.Server.Pane
        Hat.Server.Persist
        Hat.Server.Picker
        Hat.Server.Prompt
        Hat.Server.Reload
        Hat.Server.Render
        Hat.Server.Resize
        Hat.Server.Style
        Hat.Server.Target
        Hat.Server.Title
        Hat.Server.View
        Hat.Term.Cell
        Hat.Term.Emulator
        Hat.Term.Emulator.Types
        Hat.Term.HostProtocol
        Hat.Term.Pty
        Hat.Transport.Socket
        Hat.Transport.Wire
    include-dirs:       cbits
    -- hat_spawn.c is pty plumbing; ghostty_shim.c is the emulator's libghostty-vt
    -- FFI shim (bug 17).
    c-sources:
        cbits/hat_spawn.c
        cbits/ghostty_shim.c
    pkgconfig-depends:  libghostty-vt
    build-depends:
        aeson       ^>= 2.2.3.0,
        array       ^>= 0.5.8.0,
        async       ^>= 2.2.6,
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        cborg       ^>= 0.2.10.0,
        containers  ^>= 0.7,
        directory   ^>= 1.3.8.5,
        filepath    ^>= 1.5.4.0,
        megaparsec  ^>= 9.7.0,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        serialise   ^>= 0.2.6.1,
        sqlite-simple ^>= 0.4.19.0,
        stm         ^>= 2.5.3.1,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0,
        vector      ^>= 0.13.2.0

executable hat
    import:             defaults, pedantry
    hs-source-dirs:     app
    main-is:            Main.hs
    ghc-options:        -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base        ^>= 4.20.2.0,
        directory   ^>= 1.3.8.5,
        hat,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        text        ^>= 2.1.3,
        unix        ^>= 2.8.7.0
    if flag(ghc-debug)
        cpp-options:   -DGHC_DEBUG
        build-depends: ghc-debug-stub ^>= 0.8.0.0

executable gen-fixtures
    import:             defaults, pedantry
    hs-source-dirs:     tools
    main-is:            GenFixtures.hs
    ghc-options:        -threaded
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat,
        text        ^>= 2.1.3

-- Decodes a preserved reload handover (<socket>.reload.last) offline, prints
-- summary stats, and replays each pane through the emulator restore seam.
-- See tools/ReplayReload.hs.
executable replay-reload
    import:             defaults, pedantry
    hs-source-dirs:     tools
    main-is:            ReplayReload.hs
    ghc-options:        -threaded -rtsopts
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat,
        text        ^>= 2.1.3,
        vector      ^>= 0.13.2.0

test-suite hat-test
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-tool-depends: hat:hat
    other-modules:
        Hat.Bench.ResidencySpec
        Hat.Client.DrawSpec
        Hat.Client.TtySpec
        Hat.Command.ParserSpec
        Hat.FuzzyMatchSpec
        Hat.InternSpec
        Hat.IntegrationSpec
        Hat.LogSpec
        Hat.PathSpec
        Hat.Server.PersistSpec
        Hat.Term.PtySpec
        Hat.Transport.SocketSpec
        Hat.Server.CaptureSpec
        Hat.Server.ColorSchemeSpec
        Hat.Server.ConfigSpec
        Hat.Server.CopyModeSpec
        Hat.Server.EnvironSpec
        Hat.Server.FlagsSpec
        Hat.Server.FormatSpec
        Hat.Server.KeysSpec
        Hat.Server.LayoutSpec
        Hat.Server.LayoutStringSpec
        Hat.Server.OptionEffectSpec
        Hat.Server.OptionsSpec
        Hat.Server.PickerSpec
        Hat.Server.PromptSpec
        Hat.Server.ReloadSpec
        Hat.Server.SendSpec
        Hat.Server.StyleSpec
        Hat.Server.TargetSpec
        Hat.Server.TitleSpec
        Hat.Server.RenderSpec
        Hat.Server.RestoreSpec
        Hat.Server.SessionSpec
        Hat.Term.EmulatorSpec
        Hat.Term.GoldenSpec
        Hat.Transport.WireSpec
    ghc-options:        -threaded -with-rtsopts=-N
    build-depends:
        async       ^>= 2.2.6,
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        cborg       ^>= 0.2.10.0,
        containers  ^>= 0.7,
        directory   ^>= 1.3.8.5,
        filepath    ^>= 1.5.4.0,
        hspec       ^>= 2.11.17,
        serialise   ^>= 0.2.6.1,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        QuickCheck  ^>= 2.15.0.1,
        stm         ^>= 2.5.3.1,
        hat,
        sqlite-simple ^>= 0.4.19.0,
        vector      ^>= 0.13.2.0,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0

test-suite hat-upstream
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test-upstream
    main-is:            Main.hs
    build-tool-depends: hat:hat
    build-depends:
        base    ^>= 4.20.2.0,
        process ^>= 1.6.26.1

cabal-version:      3.0
name:               hat
version:            0.1.0
synopsis:           A terminal multiplexer
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Bryan Richter
maintainer:         b@chreekat.net
build-type:         Simple
tested-with:        GHC == 9.10.3

common defaults
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings

-- Warnings are mandatory: -Weverything -Werror, with a curated set of
-- exemptions. -Wno-* silences noise; -Wno-error=* keeps a warning
-- visible but non-fatal (things we intend to clean up eventually).
common pedantry
    ghc-options:
        -Werror
        -Weverything
        -Wno-all-missed-specialisations
        -Wno-missed-specialisations
        -Wno-missing-exported-signatures
        -Wno-missing-import-lists
        -Wno-missing-local-signatures
        -Wno-missing-safe-haskell-mode
        -Wno-monomorphism-restriction
        -Wno-safe
        -Wno-unsafe
        -Wno-missing-deriving-strategies
        -Wno-missing-kind-signatures
        -Wno-error=unticked-promoted-constructors
        -Wno-error=deprecations
        -Wno-error=identities
        -Wno-error=orphans
        -Wno-error=type-equality-out-of-scope
        -Wno-error=unused-type-patterns
        -- Stylistic and repo-wide; enforcing either is pure churn.
        -Wno-implicit-prelude
        -Wno-prepositive-qualified-module

library
    import:             defaults, pedantry
    hs-source-dirs:     src
    exposed-modules:
        Hat.Client
        Hat.Client.Draw
        Hat.Command.Parser
        Hat.Client.Tty
        Hat.Geometry
        Hat.Log
        Hat.Model
        Hat.Model.Ids
        Hat.Model.Options
        Hat.Pty
        Hat.Server
        Hat.Server.CopyMode
        Hat.Server.Format
        Hat.Server.Keys
        Hat.Server.Layout
        Hat.Server.Render
        Hat.Socket
        Hat.Term.Cell
        Hat.Term.Emulator
        Hat.Wire
    include-dirs:       cbits
    c-sources:          cbits/hat_shim.c
    pkgconfig-depends:  vterm
    build-depends:
        aeson       ^>= 2.2.3.0,
        async       ^>= 2.2.6,
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        containers  ^>= 0.7,
        directory   ^>= 1.3.8.5,
        filepath    ^>= 1.5.4.0,
        megaparsec  ^>= 9.7.0,
        network     ^>= 3.2.8.0,
        process     ^>= 1.6.26.1,
        serialise   ^>= 0.2.6.1,
        stm         ^>= 2.5.3.1,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0,
        vector      ^>= 0.13.2.0

executable hat
    import:             defaults, pedantry
    hs-source-dirs:     app
    main-is:            Main.hs
    ghc-options:        -threaded -rtsopts "-with-rtsopts=-N2"
    build-depends:
        base        ^>= 4.20.2.0,
        directory   ^>= 1.3.8.5,
        hat,
        network     ^>= 3.2.8.0,
        text        ^>= 2.1.3,
        unix        ^>= 2.8.7.0

executable gen-fixtures
    import:             defaults, pedantry
    hs-source-dirs:     tools
    main-is:            GenFixtures.hs
    ghc-options:        -threaded
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        hat,
        text        ^>= 2.1.3

test-suite hat-test
    import:             defaults, pedantry
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-tool-depends: hat:hat
    other-modules:
        Hat.Command.ParserSpec
        Hat.IntegrationSpec
        Hat.PtySpec
        Hat.SocketSpec
        Hat.Server.CopyModeSpec
        Hat.Server.FormatSpec
        Hat.Server.KeysSpec
        Hat.Server.LayoutSpec
        Hat.Server.RenderSpec
        Hat.Term.EmulatorSpec
        Hat.Term.GoldenSpec
        Hat.WireSpec
    ghc-options:        -threaded
    build-depends:
        base        ^>= 4.20.2.0,
        bytestring  ^>= 0.12.2.0,
        containers  ^>= 0.7,
        hspec       ^>= 2.11.17,
        process     ^>= 1.6.26.1,
        QuickCheck  ^>= 2.15.0.1,
        hat,
        vector      ^>= 0.13.2.0,
        text        ^>= 2.1.3,
        time        ^>= 1.12.2,
        unix        ^>= 2.8.7.0

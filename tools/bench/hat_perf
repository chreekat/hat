#!/usr/bin/env bash

set -Eeuo pipefail

# CPU-cost benchmark: run one pane workload at several sizes N under
# `perf stat` (instructions retired), for hat and for tmux, and fit
# instructions = slope*N + intercept per series. The slope is the marginal
# per-unit cost; the intercept absorbs startup. Server and attached client
# are measured as separate series. Black box throughout -- the real binary,
# the real --server path, a real attached client on a pty.
#
# Workloads (the unit N counts differs per workload):
#   lines       N lines of colored output printed flat out: scroll churn.
#   type        N keystrokes fed to the client's pty at ~50/s, echoed by a
#               quiet pane: the per-keystroke render path. Every 80th key is
#               Enter, so lines stay short and scrolls stay rare, like typing.
#   type4       type, with three idle panes splitting the same window.
#   typestatus  type, with the status line on.
#   restart     N lines of scrollback carried across an in-place
#               restart-server: the slope is the per-line handover cost
#               (capture, encode, decode, reseed). hat only -- tmux has no
#               equivalent. The re-exec keeps the pid, so one perf count
#               brackets both halves.
#
# The server runs in the foreground under perf and exits on its own
# kill-server, so each perf count brackets exactly one server lifetime.

SIZES=""
WORKLOADS="lines"
MUXES="hat tmux"
TMUX_BIN=tmux
BIN=""
OUT="$PWD/bench-out"
KEEP=0

usage() {
    cat <<'USAGE'
usage: hat_perf [options]

  --workloads "W W ..."  which workloads to run: lines, type, type4,
                         typestatus, restart (default "lines")
  --sizes "N N ..."      workload sizes, overriding the per-workload defaults
                         (lines: "2000 4000 8000 16000",
                          type*: "200 400 800 1600")
  --mux "M M ..."        which multiplexers to measure: hat, tmux (default both)
  --tmux BIN             the tmux binary to compare against (default: tmux)
  --bin PATH             measure this hat binary instead of building one
  --out DIR              where perf CSVs land (default ./bench-out)
  --keep                 keep each run's scratch HOME for debugging

Each workload is fixed so runs stay comparable; vary only the sizes.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --workloads) WORKLOADS="$2"; shift 2 ;;
        --sizes) SIZES="$2"; shift 2 ;;
        --mux) MUXES="$2"; shift 2 ;;
        --tmux) TMUX_BIN="$2"; shift 2 ;;
        --bin) BIN="$2"; shift 2 ;;
        --out) OUT="$2"; shift 2 ;;
        --keep) KEEP=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "hat_perf: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

sizes_for() {
    if [ -n "$SIZES" ]; then echo "$SIZES"; return; fi
    case "$1" in
        lines|restart) echo "2000 4000 8000 16000" ;;
        *) echo "200 400 800 1600" ;;
    esac
}

mkdir -p "$OUT"

# Inside the dev shell (perf on PATH) run tools directly; outside, wrap each
# call in `nix develop -c`.
if command -v perf >/dev/null; then
    dev() { "$@"; }
else
    dev() { nix develop -c "$@"; }
fi

if [ -z "$BIN" ]; then
    dev cabal build exe:hat
    BIN=$(dev cabal list-bin exe:hat)
fi
dev cabal build -v0 bench-report
REPORT=$(dev cabal list-bin bench-report)
PERF=$(dev sh -c 'command -v perf')

SOCKNAME="hat-perf-$$"

WORK=""
CTL=()
cleanup() {
    # End whichever server the current run started; its socket dies with it.
    if [ "${#CTL[@]}" -gt 0 ]; then
        "${CTL[@]}" kill-server >/dev/null 2>&1 || true
    fi
    # Statement form: a failing list at the tail of an EXIT trap would turn
    # a successful run into exit 1 under set -e.
    if [ "$KEEP" != 1 ] && [ -n "$WORK" ]; then rm -rf "$WORK"; fi
}
trap cleanup EXIT

# Sync on observable state, never a fixed sleep.
await() {
    local n=$1; shift
    while [ "$n" -gt 0 ]; do
        if "$@" >/dev/null 2>&1; then return 0; fi
        n=$((n - 1))
        sleep 0.02
    done
    return 1
}

# Whether a workload drives the client's keyboard (rather than printing
# output and, for restart, re-execing the server).
typing_wl() {
    case "$1" in type|type4|typestatus) return 0 ;; *) return 1 ;; esac
}

# Feed N keystrokes into fd $2 at ~50/s: 79 letters then Enter, repeating.
# The pace between keys comes from a timed read on an empty fifo ($3), so no
# process is spawned per key; ~50/s stays under the muxes' frame coalescing,
# giving one echoed frame per key, like a human typist.
feed_keys() {
    local n=$1 kfd=$2 pacefd=$3 i=0
    while [ "$i" -lt "$n" ]; do
        if [ $(( (i + 1) % 80 )) -eq 0 ]; then
            printf '\r' >&"$kfd"
        else
            printf 'x' >&"$kfd"
        fi
        read -r -t 0.02 -u "$pacefd" || true
        i=$((i + 1))
    done
}

# one_run MUX WORKLOAD N: measure server + client CSVs for one workload size.
one_run() {
    local mux=$1 wl=$2 n=$3
    WORK=$(mktemp -d "/tmp/hat-perf-XXXXXX")
    local sock="$WORK/socket"
    local server_csv="$OUT/$mux-$wl-server-$n.csv"
    local client_csv="$OUT/$mux-$wl-client-$n.csv"

    # Same conf for both muxes. The lines workload needs room to scroll;
    # typing barely scrolls. Only typestatus renders a status line.
    local history status
    case "$wl" in
        lines|restart) history=$((n * 2)); status=off ;;
        typestatus) history=200; status=on ;;
        *) history=200; status=off ;;
    esac
    printf 'set -g history-limit %d\nset -g status %s\n' \
        "$history" "$status" > "$WORK/conf"

    # The pane's program signals readiness by touching a file, then stays
    # alive until the driver's kill-server. The sentinel is a file, not a
    # capture-pane grep: a control client connecting in the window before the
    # attached client has created its session marks the server "served" and
    # trips its no-sessions idle-exit, killing it mid-startup.
    local ready_file="$WORK/ready"
    case "$wl" in
        lines|restart)
            # awk's pty writes block, pacing it to the server.
            cat > "$WORK/work.sh" <<EOF
awk 'BEGIN{for(i=0;i<$n;i++) printf "\033[3%dm%06d the quick brown fox jumps over the lazy dog %s\033[0m\n", i%8, i, i%2?"~~~":"..."}'
touch "$ready_file"
exec sleep 1000000
EOF
            ;;
        *)
            # cat echoes each keystroke through the pane pty's own line
            # discipline: the real type-a-key-see-it path.
            cat > "$WORK/work.sh" <<EOF
touch "$ready_file"
exec cat > /dev/null
EOF
            ;;
    esac

    # The measured server, foreground under perf; everything else is a
    # plain unmeasured client.
    local server client
    case "$mux" in
        hat)
            server=("$BIN" --server "$sock" "$WORK/conf")
            client=("$BIN" -S "$sock")
            ;;
        tmux)
            sock="$WORK/tmux-$(id -u)/$SOCKNAME"
            server=("$TMUX_BIN" -D -L "$SOCKNAME" -f "$WORK/conf")
            client=("$TMUX_BIN" -L "$SOCKNAME")
            ;;
        *) echo "hat_perf: unknown mux: $mux" >&2; exit 2 ;;
    esac
    CTL=(env "HOME=$WORK" "TMUX_TMPDIR=$WORK" "${client[@]}")

    env "HOME=$WORK" "TMUX_TMPDIR=$WORK" \
        "$PERF" stat -x, -e instructions -o "$server_csv" -- \
        "${server[@]}" > "$WORK/server.log" 2>&1 &
    local server_job=$!

    socket_up() { [ -S "$sock" ]; }
    await 250 socket_up || {
        echo "hat_perf: $mux server never created its socket; log:" >&2
        cat "$WORK/server.log" >&2
        exit 1
    }

    # Typing workloads feed the client's stdin through a fifo; keeping our
    # own read-write end open means launching the client never blocks on it
    # and it never sees EOF.
    local stdin_src=/dev/null kfd=
    if typing_wl "$wl"; then
        mkfifo "$WORK/keys.fifo" "$WORK/pace.fifo"
        exec {kfd}<>"$WORK/keys.fifo"
        stdin_src="$WORK/keys.fifo"
    fi

    # The measured client: attached on its own pty, created by script(1),
    # sized before the mux starts so both muxes render the same screen.
    script -qefc "stty rows 50 cols 200; \
        exec env HOME='$WORK' TMUX_TMPDIR='$WORK' TERM=xterm-256color \
        '$PERF' stat -x, -e instructions -o '$client_csv' -- \
        $(printf '%q ' "${client[@]}") new-session 'sh $WORK/work.sh'" \
        /dev/null < "$stdin_src" > "$WORK/client.log" 2>&1 &
    local client_job=$!

    ready() { [ -f "$ready_file" ]; }
    await 3000 ready || {
        echo "hat_perf: $mux pane never became ready; logs:" >&2
        tail -n 5 "$WORK/server.log" "$WORK/client.log" >&2
        exit 1
    }

    if typing_wl "$wl"; then
        if [ "$wl" = type4 ]; then
            "${CTL[@]}" split-window -d 'sleep 1000000'
            "${CTL[@]}" split-window -d 'sleep 1000000'
            "${CTL[@]}" split-window -d 'sleep 1000000'
        fi
        local pacefd
        exec {pacefd}<>"$WORK/pace.fifo"
        feed_keys "$n" "$kfd" "$pacefd"
        exec {pacefd}>&- {kfd}>&-
        echoed() { "${CTL[@]}" capture-pane -p | grep -q "xxxx"; }
        await 250 echoed || {
            echo "hat_perf: $mux pane never echoed the typed keys" >&2
            exit 1
        }
    fi

    if [ "$wl" = restart ]; then
        # Name the binary explicitly: the on-PATH default would re-exec
        # whatever hat is installed, not the one under measurement.
        "${CTL[@]}" restart-server "$BIN" >/dev/null 2>&1 || true
        # The consumed handover proves the successor image owns the panes;
        # answering a command proves it is serving again.
        restarted() {
            [ -f "$sock.reload.last" ] && "${CTL[@]}" list-panes
        }
        await 3000 restarted || {
            echo "hat_perf: $mux server never came back from restart-server" >&2
            tail -n 5 "$WORK/server.log" >&2
            exit 1
        }
    fi

    # kill-server is the workload's final step: the server exits on its own
    # and perf writes its count; the client follows when the server goes.
    "${CTL[@]}" kill-server >/dev/null 2>&1 || true
    wait "$server_job" 2>/dev/null || true
    wait "$client_job" 2>/dev/null || true
    CTL=()

    [ "$KEEP" = 1 ] && echo ">>> $mux $wl N=$n scratch kept in $WORK" \
        || rm -rf "$WORK"
    WORK=""
}

for mux in $MUXES; do
    for wl in $WORKLOADS; do
        if [ "$wl" = restart ] && [ "$mux" != hat ]; then
            echo ">>> skipping restart for $mux: no in-place restart to measure"
            continue
        fi
        for n in $(sizes_for "$wl"); do
            one_run "$mux" "$wl" "$n"
        done
    done
done

"$REPORT" summary "$OUT"
echo ">>> artifacts in $OUT"
